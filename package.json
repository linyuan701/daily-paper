{
  "name": "daily-paper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit && npm run typecheck:worker",
    "typecheck:worker": "npm run cf:typegen && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test scripts/daily-notifier.test.mjs scripts/daily-workflow.test.mjs scripts/profile-workflow.test.mjs && vitest run --pool=threads",
    "test:notification": "node --test scripts/daily-notifier.test.mjs",
    "test:workflow": "node --test scripts/daily-workflow.test.mjs scripts/profile-workflow.test.mjs scripts/deepseek-llm-smoke.test.mjs scripts/nvidia-llm-smoke.test.mjs scripts/ci-workflow-contract.test.mjs scripts/ci-migration-check.test.mjs scripts/production-audit-check.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "check:env": "node scripts/check-env.mjs",
    "job:daily": "node scripts/scheduler-worker.mjs --mode=daily",
    "job:daily:guard": "tsx scripts/check-daily-workflow-state.ts",
    "job:daily:cloud": "tsx scripts/run-daily-cloud.ts",
    "job:profile:cloud": "tsx scripts/run-profile-cloud.ts",
    "job:monthly-reminder": "node scripts/scheduler-worker.mjs --mode=monthly",
    "job:scheduler-loop": "node scripts/scheduler-worker.mjs --mode=loop",
    "predev": "npm run check:env",
    "prestart": "npm run check:env",
    "pretypecheck": "npm run prisma:generate:all",
    "prebuild": "npm run prisma:generate:all",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:config": "node --test scripts/check-env.test.mjs scripts/doctor.test.mjs scripts/setup.test.mjs && vitest run src/lib/config/env.test.ts --pool=threads",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:local:validate": "node scripts/validate-prisma.mjs local",
    "prisma:local:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:local:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:cloud:validate": "node scripts/validate-prisma.mjs cloud",
    "prisma:cloud:generate": "prisma generate --schema prisma/postgresql/schema.prisma --generator client",
    "prisma:worker:generate": "prisma generate --schema prisma/postgresql/schema.prisma --generator workerClient",
    "prisma:cloud:migrate:deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "prisma:generate:all": "npm run prisma:local:generate && npm run prisma:cloud:generate && npm run prisma:worker:generate",
    "test:db-contract": "npm run prisma:generate:all && node --test scripts/database-contract.test.mjs && vitest run src/db/prisma/runtime.test.ts src/db/prisma/client.test.ts src/db/repositories/postgresql-database.integration.test.ts src/db/repositories/daily-execution-postgresql.integration.test.ts src/db/repositories/manual-fallback-postgresql.integration.test.ts --pool=threads",
    "cf:build": "node scripts/run-opennext.mjs build",
    "cf:preview": "npm run cf:build && node scripts/run-opennext.mjs preview",
    "cf:deploy": "npm run cf:build && node scripts/run-opennext.mjs deploy -- --keep-vars",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist/cloudflare-dry-run",
    "cf:secret-scan": "node scripts/cloudflare-final-bundle-contract.mjs",
    "cf:typegen": "node scripts/run-cloudflare-typegen.mjs",
    "test:cloudflare": "node --test scripts/cloudflare-contract.test.mjs scripts/cloudflare-artifact-contract.test.mjs scripts/cloudflare-final-bundle-contract.test.mjs && node scripts/cloudflare-artifact-contract.mjs",
    "pretest": "npm run prisma:generate:all"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "dotenv": "^16.6.1",
    "jose": "6.2.4",
    "next": "15.5.21",
    "nodemailer": "9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260731.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
