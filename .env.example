# Local Mode is the backward-compatible default when this variable is absent.
# Cloud Mode users set this to "cloud" in platform secrets/variables and use PostgreSQL.
DEPLOYMENT_MODE="local"
DATABASE_URL="file:./dev.db"
DB_BACKUP_DIR="backups"
DB_BACKUP_RETENTION="14"
ZOTERO_KEY=""
ZOTERO_ID=""
ZOTERO_TRANSPORT="auto"
ZOTERO_LOCAL_API_URL="http://127.0.0.1:23119/api"

# Optional DeepSeek official LLM provider settings. Keep the API key only in your local .env.
LLM_PROVIDER="deepseek"
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-v4-flash"
# Deprecated compatibility alias. LLM_BASE_URL takes precedence when both are set.
# LLM_API_BASE_URL=""
LLM_TIMEOUT_MS="30000"
LLM_MAX_RETRIES="2"
LLM_CONCURRENCY="4"
LLM_LABEL_CANDIDATE_LIMIT="300"
EMBEDDING_API_KEY=""
EMBEDDING_API_BASE_URL=""
EMBEDDING_MODEL=""

# Optional journal enrichment settings
# Keep the secret in your local .env. The URL below is EasyScholar's official quick API.
EASYSCHOLAR_API_KEY=""
EASYSCHOLAR_API_URL="https://www.easyscholar.cc/open/getPublicationRank"
JOURNAL_ENRICHMENT_CACHE_TTL_HOURS="720"

# Optional source scopes (comma-separated)
ARXIV_CATEGORY_SCOPES="q-bio.BM,q-bio.GN"
ARXIV_MAX_PAGES="3"
ARXIV_RETRY_BACKOFF_MS="15000"
ARXIV_RETRY_AFTER_CAP_MS="120000"
BIORXIV_SUBJECT_SCOPES="bioinformatics,genomics"
PUBMED_QUERY_SCOPE="((\"genomics\"[Title/Abstract] OR \"genomic\"[Title/Abstract] OR \"epigenomics\"[Title/Abstract] OR \"transcriptomics\"[Title/Abstract] OR \"single-cell\"[Title/Abstract] OR \"single cell\"[Title/Abstract] OR \"multi-omics\"[Title/Abstract] OR \"multiomics\"[Title/Abstract] OR \"bioinformatics\"[Title/Abstract] OR \"computational biology\"[Title/Abstract] OR \"regulatory genomics\"[Title/Abstract] OR \"gene regulation\"[Title/Abstract] OR \"chromatin\"[Title/Abstract] OR \"rna-seq\"[Title/Abstract] OR \"scrna-seq\"[Title/Abstract] OR \"atac-seq\"[Title/Abstract] OR \"spatial transcriptomics\"[Title/Abstract] OR \"eqtl\"[Title/Abstract] OR \"gwas\"[Title/Abstract]) OR ((\"machine learning\"[Title/Abstract] OR \"deep learning\"[Title/Abstract] OR \"artificial intelligence\"[Title/Abstract]) AND (\"genomics\"[Title/Abstract] OR \"epigenomics\"[Title/Abstract] OR \"transcriptomics\"[Title/Abstract] OR \"single-cell\"[Title/Abstract] OR \"single cell\"[Title/Abstract] OR \"multi-omics\"[Title/Abstract] OR \"multiomics\"[Title/Abstract] OR \"bioinformatics\"[Title/Abstract] OR \"computational biology\"[Title/Abstract] OR \"regulatory genomics\"[Title/Abstract] OR \"chromatin\"[Title/Abstract])))"
JOURNAL_FEED_URLS=""
SOURCE_HTTP_TIMEOUT_MS="20000"
DAILY_MIN_CANDIDATE_POOL="50"
DAILY_ROLLING_LOOKBACK_DAYS="3"
DAILY_RUN_STALE_AFTER_MINUTES="180"

# Optional Obsidian export settings
OBSIDIAN_ENABLED="false"
OBSIDIAN_VAULT_PATH=""
OBSIDIAN_DAILY_DIR="Literature/Daily Triage"
OBSIDIAN_PAPERS_DIR="Literature/Papers"
OBSIDIAN_BASE_FILE="Literature/Daily Paper.base"
OBSIDIAN_FEEDBACK_SYNC_ENABLED="true"
OBSIDIAN_FEEDBACK_SYNC_MS="300000"

# Optional scheduler runner settings
# Local Mode only. Cloud scheduling is configured in the user's GitHub Actions workflow.
APP_BASE_URL="http://localhost:3000"
SCHEDULER_DAILY_UTC_HOUR="0"
SCHEDULER_MONTHLY_UTC_DAY="1"
SCHEDULER_MONTHLY_UTC_HOUR="7"
SCHEDULER_POLL_MS="60000"
SCHEDULER_RETRY_MS="900000"
SCHEDULER_STATE_PATH="artifacts/tasks/scheduler-state.json"
SCHEDULER_OBSIDIAN_PUSH_ENABLED="true"
SCHEDULER_NOTIFICATION_ENABLED="true"
SCHEDULER_DESKTOP_NOTIFICATION_ENABLED="true"
NOTIFICATION_DASHBOARD_URL=""

# Optional daily notification: WeCom bot first, SMTP email fallback
WECOM_BOT_WEBHOOK_URL=""
NOTIFICATION_SMTP_HOST=""
NOTIFICATION_SMTP_PORT="465"
NOTIFICATION_SMTP_SECURE="true"
NOTIFICATION_SMTP_USER=""
NOTIFICATION_SMTP_PASS=""
NOTIFICATION_EMAIL_FROM=""
NOTIFICATION_EMAIL_TO=""

# Optional Operations retry dispatcher. Keep the token in an injected secret, never in this file.
# The fixed repository/ref must contain .github/workflows/daily.yml.
OPERATIONS_GITHUB_OWNER=""
OPERATIONS_GITHUB_REPO=""
OPERATIONS_GITHUB_TOKEN=""
OPERATIONS_GITHUB_REF=""

# Cloud Mode contract (documentation only; do not place real credentials in this file):
# DEPLOYMENT_MODE="cloud"
# DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
# ZOTERO_TRANSPORT="web"
# OBSIDIAN_ENABLED="false"
# SCHEDULER_DESKTOP_NOTIFICATION_ENABLED="false"
# Provider region, Cloudflare Access accounts, and workflow timezone/schedule are deployment settings,
# not application defaults. Keep them out of source code and this shared template.
